{
  "name": "@hotter-keys/devtools",
  "version": "0.0.1",
  "description": "Vite devtools plugin for hotter-keys — event log, binding inspector, and more.",
  "homepage": "https://oddcelot.github.io/hotter-keys/guides/devtools",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/oddcelot/hotter-keys.git",
    "directory": "packages/vite-plugin-devtools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-devtools.d.ts",
      "default": "./dist/vite-devtools.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@vitejs/devtools-kit": "0.1.13",
    "astro": "catalog:default",
    "typescript": "catalog:default",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@vitejs/devtools-kit": ">=0.1.0",
    "astro": ">=4.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "@vitejs/devtools-kit": {
      "optional": true
    }
  }
}
