{
  "name": "@hotter-keys/devtools",
  "version": "0.0.1",
  "description": "Vite devtools plugin for hotter-keys — event log, binding inspector, and more.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-devtools.d.ts",
      "default": "./dist/vite-devtools.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "astro": ">=4.0.0",
    "vite": ">=5.0.0",
    "@vitejs/devtools-kit": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "astro": { "optional": true },
    "@vitejs/devtools-kit": { "optional": true }
  },
  "devDependencies": {
    "@vitejs/devtools-kit": "^0.1.13",
    "astro": "catalog:default",
    "typescript": "catalog:default",
    "vite": "^8.0.3"
  },
  "license": "GPL-3.0-only"
}
