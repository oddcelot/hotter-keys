{
  "name": "@hotter-keys/core",
  "version": "0.0.1",
  "description": "A correct, cross-browser, layout-aware keyboard shortcut library.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/oddcelot/hotter-keys.git",
    "directory": "core"
  },
  "homepage": "https://oddcelot.github.io/hotter-keys",
  "bugs": "https://github.com/oddcelot/hotter-keys/issues",
  "keywords": [
    "keyboard",
    "shortcuts",
    "hotkeys",
    "keybindings",
    "keyboard-shortcuts"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/test-helpers*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
